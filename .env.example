# Скопируй в .env и заполни. .env в репозиторий не попадает.

# --- бэкенд ---
APP_ENV=development
APP_PORT=8000

# SQLite для локальной работы; для PostgreSQL:
# postgresql+psycopg://mir:mir@localhost:5432/mir
DATABASE_URL=sqlite:///./data/app.db

# Источники, которым разрешены запросы с cookie (через запятую)
CORS_ORIGINS=http://localhost:5173

# Подпись JWT — обязательно заменить в production
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=720

# Заполнять справочники и создавать демо-пользователей при пустой базе
SEED_DEMO_DATA=true

# --- фронтенд ---
# Пусто = запросы идут на /api через прокси Vite или nginx
VITE_API_URL=

# --- почта для отправки КП (пока не используется) ---
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
