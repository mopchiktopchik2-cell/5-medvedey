# Скопируй в .env и заполни. .env в репозиторий не попадает.

# --- бэкенд ---
APP_ENV=development
APP_PORT=8000
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173

# --- фронтенд ---
# Пусто = запросы идут на /api через прокси Vite
VITE_API_URL=

