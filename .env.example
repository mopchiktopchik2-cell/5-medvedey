# Скопируй в .env и заполни. .env в репозиторий не попадает.

# --- бэкенд ---
APP_ENV=development
APP_PORT=8000

# SQLite для локальной работы; для PostgreSQL:
# postgresql+psycopg://mir:mir@localhost:5432/mir
DATABASE_URL=sqlite:///./data/app.db

# Пароль PostgreSQL для docker-compose.postgres.yml
# POSTGRES_PASSWORD=

# Источники, которым разрешены запросы с cookie (через запятую)
CORS_ORIGINS=http://localhost:5173

# Подпись JWT — обязательно заменить в production
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=720

# Заполнять справочники и создавать демо-пользователей при пустой базе
SEED_DEMO_DATA=true

# --- фронтенд ---
# Пусто = запросы идут на /api через прокси Vite или nginx
VITE_API_URL=

# --- почта для отправки КП ---
# Пока SMTP_HOST пуст, письма сохраняются в backend/data/outbox/*.eml
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=manager@mir.ru
# SMTP_PASSWORD=
# SMTP_FROM=manager@mir.ru
# SMTP_USE_SSL=true
# SMTP_STARTTLS=false
# SMTP_TIMEOUT_SECONDS=15
# OUTBOX_DIR=./data/outbox

# --- загрузки ---
# Логотип цеха для PDF и публичной страницы (внутри контейнера — /app/data/uploads)
# UPLOADS_DIR=./data/uploads
