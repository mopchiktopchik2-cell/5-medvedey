# Скопируй в .env и заполни. .env в репозиторий не попадает.
# `scripts/setup.ps1` создаёт .env и сразу генерирует SECRET_KEY.

# --- бэкенд ---
APP_ENV=development
APP_PORT=8000

# SQLite для локальной работы; для PostgreSQL:
# postgresql+psycopg://mir:mir@localhost:5432/mir
DATABASE_URL=sqlite:///./data/app.db

# Пароль PostgreSQL для docker-compose.postgres.yml
# POSTGRES_PASSWORD=

# Источники, которым разрешены запросы с cookie (через запятую)
CORS_ORIGINS=http://localhost:5173

# Подпись JWT. В production обязателен случайный ключ, иначе приложение
# не стартует. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Пока строка закомментирована, в development используется небезопасный дефолт.
# SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=720

# Secure-cookie. Пусто — включаются автоматически при APP_ENV=production.
# COOKIE_SECURE=true
# Для временного запуска production по HTTP без TLS: COOKIE_SECURE=false

# Сколько дней живёт публичная ссылка на КП
SHARE_TOKEN_TTL_DAYS=30

# Защита от перебора пароля: попыток до блокировки и время блокировки
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Заполнять справочники и создавать демо-пользователей при пустой базе.
# В production выключено в docker-compose.yml: первого технолога создавайте
# командой `python -m app.cli create-user`.
SEED_DEMO_DATA=true

# --- фронтенд ---
# Пусто = запросы идут на /api через прокси Vite или nginx
VITE_API_URL=

# --- почта для отправки КП ---
# Пока SMTP_HOST пуст, письма сохраняются в backend/data/outbox/*.eml
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=manager@mir.ru
# SMTP_PASSWORD=
# SMTP_FROM=manager@mir.ru
# SMTP_USE_SSL=true
# SMTP_STARTTLS=false
# SMTP_TIMEOUT_SECONDS=15
# OUTBOX_DIR=./data/outbox

# --- загрузки ---
# Логотип цеха для PDF и публичной страницы (внутри контейнера — /app/data/uploads).
# Максимальный размер файла — 2 МБ.
# UPLOADS_DIR=./data/uploads
